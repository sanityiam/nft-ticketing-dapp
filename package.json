{
  "name": "nft-ticketing-dapp",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "node": "hardhat node",
    "deploy:local": "hardhat run scripts/deploy.ts --network localhost",
    "smoke": "hardhat run scripts/smoke.ts --network localhost",
    "smoke:nocheck": "DO_CHECKIN=0 hardhat run scripts/smoke.ts --network localhost",
    "checkin": "hardhat run scripts/checkin-smoke.ts --network localhost",
    "demo": "hardhat run scripts/demo.ts",
    "demo:reset": "hardhat clean && npm run demo",
    "test": "hardhat test",
    "metadata:sepolia": "DEPLOYMENT_NAME=sepolia hardhat run scripts/generate-metadata.ts --network sepolia",
    "metadata:local": "DEPLOYMENT_NAME=localhost hardhat run scripts/generate-metadata.ts --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^4.0.4",
    "@nomicfoundation/hardhat-ignition": "^3.0.7",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^3.0.2",
    "@types/chai": "^4.3.20",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.11",
    "chai": "^5.3.3",
    "dotenv": "^17.3.1",
    "ethers": "^6.16.0",
    "forge-std": "github:foundry-rs/forge-std#v1.9.4",
    "hardhat": "^3.1.8",
    "mocha": "^11.7.5",
    "typescript": "~5.8.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.4.0",
    "chalk": "^5.6.2"
  }
}